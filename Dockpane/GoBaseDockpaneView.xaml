<UserControl x:Class="GoBase.Dockpane.GoBaseDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:login="clr-namespace:GoBase.Pages.Login"
             xmlns:catalog="clr-namespace:GoBase.Pages.Catalog"
             xmlns:about="clr-namespace:GoBase.Pages.About"
             mc:Ignorable="d"
             d:DataContext="{Binding Path=ui.GoBaseDockpaneViewModel}"
             FontFamily="Segoe UI"
             MinWidth="540"
             MinHeight="330">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GoBase;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Which view draws which page: WPF picks the template by the page's type. -->
            <DataTemplate DataType="{x:Type login:LoginViewModel}">
                <login:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type catalog:CatalogViewModel}">
                <catalog:CatalogView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type about:AboutViewModel}">
                <about:AboutView/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource RasidBackgroundBrush}">
        <Border DockPanel.Dock="Left"
                Width="132"
                Background="White"
                BorderBrush="{StaticResource RasidBorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding IsNavigationVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,12,10,4">
                    <Image Source="/GoBase;component/Images/logo.png"
                           Height="58"
                           Stretch="Uniform"/>
                    <TextBlock Text="{Binding WelcomeText}"
                               Margin="0,7,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource RasidTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Separator Grid.Row="1" Margin="10,4" Background="{StaticResource RasidBorderBrush}"/>

                <StackPanel Grid.Row="2" Margin="0,4,0,0">
                    <ToggleButton Content="▦  Catalog"
                                  Style="{StaticResource RasidNavButtonStyle}"
                                  IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Catalog, Mode=OneWay}"
                                  Command="{Binding ShowCatalogCommand}"/>
                    <ToggleButton Content="ⓘ  About"
                                  Style="{StaticResource RasidNavButtonStyle}"
                                  IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=About, Mode=OneWay}"
                                  Command="{Binding ShowAboutCommand}"/>
                </StackPanel>

                <Button Grid.Row="3"
                        Content="Log Out"
                        Command="{Binding LogOutCommand}"
                        Margin="12,8,12,12"
                        Padding="10,6"
                        Foreground="{StaticResource RasidDangerBrush}"
                        BorderBrush="#DFA7A7"
                        Style="{StaticResource RasidSecondaryButtonStyle}"/>
            </Grid>
        </Border>

        <Border Background="White" Margin="0">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>
    </DockPanel>
</UserControl>
