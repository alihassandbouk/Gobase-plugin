<UserControl x:Class="Rasid.Pages.Solutions.SolutionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource RasidBackgroundBrush}" Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Solutions" Style="{StaticResource RasidPageTitleStyle}"/>
        <TextBlock Grid.Row="1"
                   Text="Choose a geospatial solution and create a new project."
                   Foreground="{StaticResource RasidMutedTextBrush}"
                   FontSize="11"
                   Margin="0,3,0,12"/>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Solutions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Style="{StaticResource RasidCardBorderStyle}"
									Width="280"
									Margin="0,0,12,12">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="120"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<Border Background="#EEF2F3"
		CornerRadius="4"
		ClipToBounds="True"
		Height="120">

										<Grid>
											<Image Source="{Binding Thumbnail}"
			   Stretch="UniformToFill"
			   HorizontalAlignment="Stretch"
			   VerticalAlignment="Stretch"/>

											<TextBlock Text="Image unavailable"
				   Foreground="{StaticResource RasidMutedTextBrush}"
				   FontSize="10"
				   HorizontalAlignment="Center"
				   VerticalAlignment="Center">

												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Setter Property="Visibility"
							Value="Collapsed"/>

														<Style.Triggers>
															<DataTrigger Binding="{Binding Thumbnail}"
									 Value="{x:Null}">
																<Setter Property="Visibility"
									Value="Visible"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
										</Grid>
									</Border>

									<Grid Grid.Row="1" Margin="0,12,0,6">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<TextBlock Text="{Binding Name}"
												   FontWeight="SemiBold"
												   FontSize="14"
												   Foreground="{StaticResource RasidTextBrush}"
												   TextWrapping="Wrap"/>
										<Border Grid.Column="1"
												Background="{StaticResource RasidPrimarySoftBrush}"
												CornerRadius="8"
												Padding="8,3"
												Margin="8,0,0,0"
												VerticalAlignment="Top">
											<TextBlock Text="{Binding StatusLabel}"
													   Foreground="{StaticResource RasidPrimaryBrush}"
													   FontSize="9"
													   FontWeight="SemiBold"/>
										</Border>
									</Grid>

									<Grid Grid.Row="2">
										<TextBlock Foreground="{StaticResource RasidMutedTextBrush}"
												   FontSize="11"
												   TextWrapping="Wrap"
												   LineHeight="16"
												   Margin="0,0,0,4">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="{Binding ShortDescriptionText}"/>
													<Setter Property="MaxHeight" Value="64"/>
													<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsDescriptionExpanded}" Value="True">
															<Setter Property="Text" Value="{Binding DescriptionText}"/>
															<Setter Property="MaxHeight" Value="9999"/>
															<Setter Property="TextTrimming" Value="None"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Grid>

									<Button Grid.Row="3"
											Command="{Binding ToggleDescriptionCommand}"
											HorizontalAlignment="Left"
											Background="Transparent"
											BorderThickness="0"
											Padding="0"
											Margin="0,0,0,8"
											Cursor="Hand">
										<Button.Style>
											<Style TargetType="Button">
												<Setter Property="Visibility" Value="Visible"/>
												<Setter Property="Template">
													<Setter.Value>
														<ControlTemplate TargetType="Button">
															<TextBlock Foreground="{StaticResource RasidPrimaryBrush}"
																	   FontSize="10"
																	   FontWeight="Medium"
																	   Text="{Binding ShowMoreText}"
																	   TextDecorations="Underline"/>
														</ControlTemplate>
													</Setter.Value>
												</Setter>
												<Style.Triggers>
													<DataTrigger Binding="{Binding HasLongDescription}" Value="False">
														<Setter Property="Visibility" Value="Collapsed"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Button.Style>
									</Button>

									<TextBlock Grid.Row="4"
											   Text="{Binding PriceText}"
											   FontSize="11"
											   FontWeight="SemiBold"
											   Foreground="{StaticResource RasidTextBrush}"
											   Margin="0,0,0,10"/>

									<Button Grid.Row="5"
											Content="Create Project"
											Command="{Binding CreateProjectCommand}"
											IsEnabled="{Binding IsAvailable}"
											Style="{StaticResource RasidPrimaryButtonStyle}"/>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource RasidMutedTextBrush}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
