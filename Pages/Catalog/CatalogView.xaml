<UserControl x:Class="GoBase.Pages.Catalog.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GoBase;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource RasidBackgroundBrush}" Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Catalog" Style="{StaticResource RasidPageTitleStyle}"/>

        <!-- Search box and type filter. Enter in the box searches. -->
        <Grid Grid.Row="1" Margin="0,10,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RasidTextBoxStyle}"
                     ToolTip="Searches names, datasets, topics, formats and column names">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding SelectedType}"
                      DisplayMemberPath="Label"
                      MinWidth="110"
                      Margin="6,0,0,0"
                      VerticalContentAlignment="Center"/>
            <Button Grid.Column="2"
                    Content="Search"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource RasidPrimaryButtonStyle}"
                    Padding="14,6"
                    Margin="6,0,0,0"/>
        </Grid>

        <CheckBox Grid.Row="2"
                  Content="Only assets in the current map view"
                  IsChecked="{Binding OnlyInMapView}"
                  Foreground="{StaticResource RasidMutedTextBrush}"
                  Margin="0,0,0,10"/>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Assets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RasidCardBorderStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Width="38" Height="38" CornerRadius="5" Background="{StaticResource RasidPrimarySoftBrush}">
                                        <TextBlock Text="{Binding Glyph}" FontSize="17" Foreground="{StaticResource RasidPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"
                                                   Foreground="{StaticResource RasidTextBrush}"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource RasidMutedTextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Zoom to"
                                                Command="{Binding ZoomCommand}"
                                                IsEnabled="{Binding CanZoom}"
                                                Style="{StaticResource RasidSecondaryButtonStyle}"
                                                Padding="10,6"
                                                Margin="0,0,6,0"/>
                                        <Button Content="{Binding ActionText}"
                                                Command="{Binding AddToMapCommand}"
                                                IsEnabled="{Binding IsActionEnabled}"
                                                Style="{StaticResource RasidPrimaryButtonStyle}"
                                                Padding="12,6"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding RowStatus}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource RasidMutedTextBrush}"
                                               Margin="12,6,0,0"
                                               Visibility="{Binding RowStatus, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Foreground="{StaticResource RasidMutedTextBrush}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Grid>

        <!-- Paging -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding PageText}"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource RasidMutedTextBrush}"/>
            <Button Grid.Column="1"
                    Content="Previous"
                    Command="{Binding PreviousPageCommand}"
                    IsEnabled="{Binding CanGoPrevious}"
                    Style="{StaticResource RasidSecondaryButtonStyle}"
                    Padding="12,5"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="2"
                    Content="Next"
                    Command="{Binding NextPageCommand}"
                    IsEnabled="{Binding CanGoNext}"
                    Style="{StaticResource RasidSecondaryButtonStyle}"
                    Padding="12,5"/>
        </Grid>
    </Grid>
</UserControl>
