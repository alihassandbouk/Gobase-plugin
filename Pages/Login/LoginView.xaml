<UserControl x:Class="GoBase.Pages.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GoBase;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#173C40">
            <StackPanel VerticalAlignment="Center" Margin="30">
                <Image Source="/GoBase;component/Images/icon_nobg.png" Height="90" Stretch="Uniform"/>
                <TextBlock Text="GoBase"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>
                <TextBlock Text="Browse the geospatial catalog and load its layers directly inside ArcGIS Pro."
                           Foreground="#DCEBEC"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="48,36" VerticalAlignment="Center" MaxWidth="420">
            <TextBlock Text="Connect to GoBase" Style="{StaticResource RasidPageTitleStyle}"/>
            <TextBlock Text="Sign in with your Geo Portal username and password."
                       Margin="0,4,0,20"
                       Foreground="{StaticResource RasidMutedTextBrush}"/>

            <TextBlock Text="Server" Style="{StaticResource RasidSectionTitleStyle}"/>
            <TextBox Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RasidTextBoxStyle}"
                     ToolTip="For example https://portal.example"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Username" Style="{StaticResource RasidSectionTitleStyle}"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource RasidTextBoxStyle}"
                     Margin="0,5,0,12"/>

            <TextBlock Text="Password" Style="{StaticResource RasidSectionTitleStyle}"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordInput"
                             Grid.Column="0"
                             Style="{StaticResource RasidPasswordBoxStyle}"
                             PasswordChanged="PasswordInput_OnPasswordChanged"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <PasswordBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConnectCommand}"/>
                    </PasswordBox.InputBindings>
                </PasswordBox>
                <TextBox Grid.Column="0"
                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RasidTextBoxStyle}"
                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="1"
                        Content="👁"
                        Width="42"
                        Margin="5,0,0,0"
                        Command="{Binding ToggleVisibilityCommand}"
                        Style="{StaticResource RasidSecondaryButtonStyle}"/>
            </Grid>

            <Button Content="Connect"
                    Command="{Binding ConnectCommand}"
                    Margin="0,16,0,0"
                    Style="{StaticResource RasidPrimaryButtonStyle}"/>

            <TextBlock Text="{Binding ErrorText}"
                       Foreground="{StaticResource RasidDangerBrush}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibilityConverter}}"/>

            <TextBlock Text="Your password is not stored: ArcGIS Pro keeps a key for this computer instead."
                       Margin="0,18,0,0"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource RasidMutedTextBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
