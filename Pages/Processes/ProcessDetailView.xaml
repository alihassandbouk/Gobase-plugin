<UserControl x:Class="Rasid.Pages.Processes.ProcessDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource RasidPageTitleStyle}"/>
                <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="9" Padding="9,3">
                    <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <TextBlock Text="{Binding NotCompletedMessage}"
                       Foreground="{StaticResource RasidMutedTextBrush}"
                       Margin="0,12,0,0"
                       Visibility="{Binding NotCompletedMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

            <TextBlock Text="General Information" Style="{StaticResource RasidSectionTitleStyle}" Margin="0,16,0,7"/>
            <Border Style="{StaticResource RasidCardBorderStyle}" Padding="10">
                <ItemsControl ItemsSource="{Binding GeneralInfo}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Foreground="{StaticResource RasidMutedTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource RasidTextBrush}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Visibility="{Binding HasAnalytics, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Analytics" Style="{StaticResource RasidSectionTitleStyle}" Margin="0,16,0,7"/>
                <Border Style="{StaticResource RasidCardBorderStyle}" Padding="10">
                    <ItemsControl ItemsSource="{Binding Analytics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="3,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Key}" Foreground="{StaticResource RasidMutedTextBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource RasidTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowDownloads, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Results" Style="{StaticResource RasidSectionTitleStyle}" Margin="0,16,0,7"/>
                <WrapPanel>
                    <Button Content="{Binding ResultVectorButtonText}"
                            Command="{Binding DownloadResultCommand}"
                            Style="{StaticResource RasidPrimaryButtonStyle}"
                            Margin="0,0,8,8"
                            Visibility="{Binding ResultVectorUrl, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <Button Content="{Binding DatasetButtonText}"
                            Command="{Binding DownloadDatasetCommand}"
                            Style="{StaticResource RasidSecondaryButtonStyle}"
                            Margin="0,0,8,8"
                            Visibility="{Binding DatasetUrl, Converter={StaticResource StringToVisibilityConverter}}"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
