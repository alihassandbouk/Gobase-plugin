<UserControl x:Class="Rasid.Pages.Processes.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:Rasid.Pages.CreateProcessWizard"
             xmlns:processes="clr-namespace:Rasid.Pages.Processes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type wizard:CreateProcessWizardViewModel}">
                <wizard:CreateProcessWizardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type processes:ProcessDetailViewModel}">
                <processes:ProcessDetailView/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource RasidBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="14,10,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding ProjectTitle}" Style="{StaticResource RasidPageTitleStyle}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{StaticResource RasidMutedTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="← Back"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource RasidSecondaryButtonStyle}"
                    Visibility="{Binding IsWizardActive, Converter={StaticResource BoolToVis}}"/>
            <Button Grid.Column="1"
                    Content="+ New Process"
                    Command="{Binding NewProcessCommand}"
                    Style="{StaticResource RasidPrimaryButtonStyle}"
                    Visibility="{Binding IsWizardActive, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid Visibility="{Binding IsWizardActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="White" BorderBrush="{StaticResource RasidBorderBrush}" BorderThickness="0,1,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Processes}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}"
                                            HorizontalContentAlignment="Stretch"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            Margin="0,0,0,5"
                                            Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Card"
                                                        Background="White"
                                                        BorderBrush="{StaticResource RasidBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="9">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding Process.Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource RasidTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Row="1"
                                                                Background="{Binding StatusColor}"
                                                                CornerRadius="7"
                                                                Padding="7,2"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,6,0,0">
                                                            <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontSize="9"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="{StaticResource RasidPrimarySoftBrush}"/>
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource RasidPrimaryBrush}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource RasidPrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding Detail}"/>
            </Grid>

            <ContentControl Content="{Binding BodyContent}"
                            Visibility="{Binding IsWizardActive, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>
