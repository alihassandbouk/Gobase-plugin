<UserControl x:Class="Rasid.Pages.Projects.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource RasidBackgroundBrush}" Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Projects" Style="{StaticResource RasidPageTitleStyle}"/>
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource RasidSecondaryButtonStyle}"
                    Padding="12,5"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="Open a project to view its processes and results."
                   Foreground="{StaticResource RasidMutedTextBrush}"
                   FontSize="11"
                   Margin="0,3,0,12"/>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RasidCardBorderStyle}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="5" Background="{StaticResource RasidPrimarySoftBrush}">
                                        <TextBlock Text="▣" FontSize="18" Foreground="{StaticResource RasidPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Project.Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource RasidTextBrush}"/>
                                        <TextBlock Text="{Binding Project.Slug, StringFormat='Project ID: {0}'}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource RasidMutedTextBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Open"
                                            Command="{Binding OpenCommand}"
                                            Style="{StaticResource RasidPrimaryButtonStyle}"
                                            Padding="16,7"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource RasidMutedTextBrush}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
