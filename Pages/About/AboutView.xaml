<UserControl x:Class="Rasid.Pages.About.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource RasidBackgroundBrush}">
        <Border Style="{StaticResource RasidCardBorderStyle}"
                Width="430"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <Image Source="/RASID;component/Images/logo.png" Height="92" Stretch="Uniform"/>
                <TextBlock Text="RASID for ArcGIS Pro"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource RasidTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0"/>
                <TextBlock Text="{Binding VersionText}"
                           Foreground="{StaticResource RasidMutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
				<TextBlock Text="RASID specializes in AI-driven analysis of satellite imagery to provide critical insights for better decision-making. Our team of experts combines deep knowledge in AI, geospatial data, and industry-specific solutions.

RASID goes beyond a one-size-fits-all model, offering customized geospatial analysis projects that align with the unique requirements of your industry. Our team is prepared to act on innovative solutions.

Our expertise is designed to provide actionable insights that can be directly applied to the most pressing challenges in your sector."
                           Foreground="{StaticResource RasidMutedTextBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,18,0,20"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Visit Website"
                            Command="{Binding OpenWebsiteCommand}"
                            Style="{StaticResource RasidPrimaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="Terms"
                            Command="{Binding OpenTermsCommand}"
                            Style="{StaticResource RasidSecondaryButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="{Binding CopyrightText}"
                           FontSize="9.5"
                           Foreground="{StaticResource RasidMutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
