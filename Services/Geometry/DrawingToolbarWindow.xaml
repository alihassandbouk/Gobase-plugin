<!-- DrawingToolbarWindow.xaml -->
<Window x:Class="Rasid.Services.Geometry.DrawingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight">
	<Border Background="#D91E293B" CornerRadius="12" Padding="16">
		<StackPanel Width="240">
			<TextBlock Text="✏️ Drawing Mode" FontWeight="Bold" Foreground="White" FontSize="14"/>
			<TextBlock Text="{Binding InfoText}" Foreground="#B3FFFFFF" FontSize="11" Margin="0,8" TextWrapping="Wrap"/>
			<Button Content="✕ Cancel (ESC)" Command="{Binding CancelCommand}" Margin="0,8,0,0"/>
		</StackPanel>
	</Border>
</Window>