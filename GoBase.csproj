<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GoBase</RootNamespace>
    <AssemblyName>GoBase</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NoWarn>CA1416</NoWarn>
    <!-- Lets the .NET SDK on Linux compile this Windows (WPF) project. It changes nothing on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Config.daml" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Config.daml" />
    <Content Include="Images\AddInDesktop16.png" />
    <Content Include="Images\AddInDesktop32.png" />
    <Content Include="DarkImages\AddInDesktop16.png" />
    <Content Include="DarkImages\AddInDesktop32.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Images\logo.png" />
    <None Remove="Images\icon.png" />
    <None Remove="Images\icon_nobg.png" />
    <Resource Include="Images\logo.png" />
    <Resource Include="Images\icon.png" />
    <Resource Include="Images\icon_nobg.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Esri's reference assemblies and build targets: the add-in builds without ArcGIS Pro installed.
         The version must match the Pro release in Config.daml (desktopVersion). -->
    <PackageReference Include="Esri.ArcGISPro.Extensions30" Version="3.7.0.1901" />
  </ItemGroup>
</Project>
